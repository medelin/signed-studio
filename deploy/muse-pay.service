# Signed Studio, PayPal edition: uvicorn on 127.0.0.1:8100 behind any reverse proxy
# (Apache, nginx or Caddy; see deploy/PAY-DEPLOY.md). Installed by deploy/pay-install.sh.
# Its own user, port, data, env file and unit name: nothing is shared with another studio
# on the same host.
[Unit]
Description=Signed Studio (PayPal edition, sandbox)
Documentation=file:///opt/muse-pay/current/deploy/PAY-DEPLOY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=muse-pay
Group=muse-pay
WorkingDirectory=/opt/muse-pay/current
EnvironmentFile=/etc/muse-pay/env
Environment=STUDIO_SANDBOX=1 STUDIO_DATA_DIR=/var/lib/muse-pay PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# --no-proxy-headers: the app trusts X-Forwarded-For only from TRUSTED_PROXY (the proxy).
ExecStart=/opt/muse-pay/current/.venv/bin/python -m uvicorn studio.app:app \
    --host 127.0.0.1 --port 8100 --workers 1 --no-proxy-headers --no-server-header \
    --no-access-log --limit-concurrency 64 --timeout-graceful-shutdown 10
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

MemoryMax=768M
MemoryHigh=640M
TasksMax=128
LimitNOFILE=4096

UMask=0077
StateDirectory=muse-pay
StateDirectoryMode=0700
ReadWritePaths=/var/lib/muse-pay
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
