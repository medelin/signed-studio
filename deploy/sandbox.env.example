# Judge sandbox environment (copy to sandbox.env for docker compose, or to
# /etc/muse-studio-lite/env for the systemd deployment; mode 600 / root:muse 640).
# Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # JUDGE_PASSWORD
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # SESSION_SECRET
MODEL_API_KEY=replace-me
JUDGE_PASSWORD=replace-me
SESSION_SECRET=replace-me
META_ADAPTER=mock
# Live Meta for judges (PAUSED only, see docs/SANDBOX.md): META_ADAPTER=graph +
# STUDIO_SANDBOX_LIVE_META=1 + META_ACCESS_TOKEN/AD_ACCOUNT_ID/PAGE_ID/LANDING_URL
STUDIO_DAILY_BUDGET_USD=8
COOKIE_SECURE=1
# STUDIO_REQUIRE_LOGIN defaults to 1 with STUDIO_SANDBOX=1: the whole app is behind /login
TRUSTED_PROXY=127.0.0.1
STUDIO_READ_ONLY=0
STUDIO_REPLAY=0
# Optional second-opinion reviewer:
# BASETEN_API_KEY=
# Optional e-mail notifications from the studio (studio/notify.py). Off unless configured.
# STUDIO_MAIL_TRANSPORT=jmap             # jmap (HTTPS, primary) | smtp (465, implicit TLS) | mock
# STUDIO_JMAP_SESSION_URL=https://mail.example.org/jmap/session
# STUDIO_MAIL_USER=muse@example.org
# STUDIO_MAIL_PASSWORD=replace-me        # an app password
# STUDIO_MAIL_FROM=Muse Studio Lite <muse@example.org>
# STUDIO_PUBLIC_URL=https://studio.example.org   # base of the links in the mails
# For smtp: STUDIO_SMTP_HOST=mail.example.org, STUDIO_SMTP_PORT=465
# Registration with PayPal / Facebook / Google (docs/SANDBOX.md); redirect URIs end in
# /auth/paypal/callback, /auth/facebook/callback and /auth/google/callback under
# STUDIO_PUBLIC_URL. PayPal sign-in is sandbox only (PAYPAL_ENV stays "sandbox").
# PAYPAL_LOGIN_CLIENT_ID=replace-me
# PAYPAL_LOGIN_CLIENT_SECRET=replace-me
# GOOGLE_LOGIN_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_LOGIN_CLIENT_SECRET=replace-me
# FACEBOOK_LOGIN_CLIENT_ID=replace-me
# FACEBOOK_LOGIN_CLIENT_SECRET=replace-me
# PayPal (sandbox only; docs/SANDBOX.md). No values here: the real ones live in the
# server's env file (mode 600). PAYPAL_ENV must stay "sandbox".
# PAYPAL_ADAPTER=rest
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# STUDIO_FEE_PCT=5
# STUDIO_SELLER_NUMBER=
# STUDIO_SELLER_ADDRESS=
# STUDIO_BRAND_SCAN=1
