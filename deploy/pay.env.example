# Signed Studio, PayPal edition: /etc/muse-pay/env (root:muse-pay 0640). No real values in
# git. Generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # JUDGE_PASSWORD
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # SESSION_SECRET
MODEL_API_KEY=replace-me
JUDGE_PASSWORD=replace-me
SESSION_SECRET=replace-me
META_ADAPTER=mock
STUDIO_DAILY_BUDGET_USD=8
COOKIE_SECURE=1
# the reverse proxy on this host: the only source of X-Forwarded-For the app trusts
TRUSTED_PROXY=127.0.0.1
# the public https:// address (PayPal return URLs, e-mail links)
STUDIO_PUBLIC_URL=https://pay.example.org
STUDIO_READ_ONLY=0
STUDIO_REPLAY=0
# PayPal: sandbox only. Any PAYPAL_ENV other than "sandbox" stops the app at start.
PAYPAL_ADAPTER=rest
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me
# set after `POST /v1/notifications/webhooks` registered https://<host>/webhooks/paypal
PAYPAL_WEBHOOK_ID=
STUDIO_FEE_PCT=5
