    {
      "auth": {
        "type": "noauth"
      },
      "id": "dfa736bd-b754-5551-af77-f34e25e53a79",
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('paypal_access_token', pm.response.json().access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "ac642765-4be7-5515-8b04-97eded72e4be",
          "name": "OAuth token",
          "request": {
            "auth": {
              "basic": [
                {
                  "key": "username",
                  "type": "string",
                  "value": "{{paypal_client_id}}"
                },
                {
                  "key": "password",
                  "type": "string",
                  "value": "{{paypal_client_secret}}"
                }
              ],
              "type": "basic"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "description": "Sandbox client credentials -> access token (saved to paypal_access_token).",
            "header": [],
            "method": "POST",
            "url": {
              "host": [
                "{{paypal_base}}"
              ],
              "path": [
                "v1",
                "oauth2",
                "token"
              ],
              "query": [],
              "raw": "{{paypal_base}}/v1/oauth2/token"
            }
          },
          "response": []
        },
        {
          "id": "ab24589d-6499-5abe-aca2-66f7f500b054",
          "name": "Create order (AUTHORIZE)",
          "request": {
            "auth": {
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{paypal_access_token}}"
                }
              ],
              "type": "bearer"
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"intent\": \"AUTHORIZE\",\n  \"payment_source\": {\n    \"paypal\": {\n      \"experience_context\": {\n        \"shipping_preference\": \"NO_SHIPPING\",\n        \"user_action\": \"CONTINUE\"\n      }\n    }\n  },\n  \"purchase_units\": [\n    {\n      \"amount\": {\n        \"breakdown\": {\n          \"item_total\": {\n            \"currency_code\": \"EUR\",\n            \"value\": \"10.00\"\n          }\n        },\n        \"currency_code\": \"EUR\",\n        \"value\": \"10.00\"\n      },\n      \"custom_id\": \"{{content_sha256}}\",\n      \"invoice_id\": \"{{invoice_id}}\",\n      \"reference_id\": \"default\"\n    }\n  ]\n}"
            },
            "description": "A person approves it as the sandbox buyer; nothing moves before that.",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{paypal_base}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders"
              ],
              "query": [],
              "raw": "{{paypal_base}}/v2/checkout/orders"
            }
          },
          "response": []
        },
        {
          "id": "3d61d29e-4c54-5b4a-a3aa-d9daf72a0d36",
          "name": "Authorize order",
          "request": {
            "auth": {
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{paypal_access_token}}"
                }
              ],
              "type": "bearer"
            },
            "description": "",
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "{{$guid}}"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{paypal_base}}"
              ],
              "path": [
                "v2",
                "checkout",
                "orders",
                "{{order_id}}",
                "authorize"
              ],
              "query": [],
              "raw": "{{paypal_base}}/v2/checkout/orders/{{order_id}}/authorize"
            }
          },
          "response": []
        },
        {
          "id": "cc536e35-3d78-582b-9100-6c0696c83ef0",
          "name": "Capture authorization",
          "request": {
            "auth": {
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{paypal_access_token}}"
                }
              ],
              "type": "bearer"
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
